# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding model (downloads automatically on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval settings
TOP_K=5

# Pipeline strategies: chunker fixed|sentence, retriever dense|bm25|hybrid, reranker none|keyword|cross_encoder
CHUNKER_STRATEGY=sentence
RETRIEVER_STRATEGY=hybrid
RERANKER_STRATEGY=keyword
MIN_RELEVANCE_SCORE=0.0

# Security and ops (empty API_KEY disables auth)
API_KEY=
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
